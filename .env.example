# Track Quality Pack - example environment configuration.
# Copy to .env.local and replace the placeholders. Never commit real values.

# Supabase PostgreSQL connection string (server-side only).
Supabase_DB_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# File storage: "local" (development) or "azure-blob".
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
AZURE_STORAGE_CONNECTION_STRING="REPLACE_WITH_AZURE_STORAGE_CONNECTION_STRING"
AZURE_STORAGE_CONTAINER="track-quality-pack"
